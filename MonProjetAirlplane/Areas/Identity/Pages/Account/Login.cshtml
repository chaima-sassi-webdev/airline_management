@page
@model LoginModel

@{
    ViewData["Title"] = "Connexion - Tunisair";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #004b87 0%, #002752 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }
        .login-card {
            background: #ffffff;
            padding: 3rem 4rem;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 600px; 
        }
        .login-logo {
            text-align: center;
            margin-bottom: 2.5rem;
        }
        .login-logo h2 {
            font-weight: 700;
            color: #004b87;
            margin-bottom: 0.4rem;
            font-size: 2rem;
        }
        .form-group-custom {
            margin-bottom: 1.5rem;
        }
        .form-group-custom label {
            display: block;
            font-weight: 600;
            font-size: 0.9rem;
            color: #495057;
            margin-bottom: 0.6rem;
        }
        .form-group-custom input.form-control {
            width: 100% !important;
            padding: 0.85rem 1.1rem;
            font-size: 1rem;
            border-radius: 8px;
            border: 1px solid #ced4da;
        }
        .form-group-custom input.form-control:focus {
            border-color: #004b87;
            box-shadow: 0 0 0 0.25rem rgba(0, 75, 135, 0.15);
        }
        .btn-tunisair {
            background-color: #004b87;
            border-color: #004b87;
            color: #ffffff;
            width: 100%;
            padding: 0.85rem;
            font-weight: 650;
            font-size: 1.05rem;
            border-radius: 8px;
            transition: background-color 0.2s;
        }
        .btn-tunisair:hover {
            background-color: #00335e;
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-logo">
            <h2>✈️ Tunisair</h2>
            <p class="text-muted mb-0">Espace Administrateur & Gestion</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <!-- Champ Email -->
            <div class="form-group-custom">
                <label asp-for="Input.Email">
                    <i class="fas fa-envelope me-1 text-primary"></i> Adresse Email
                </label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nom@tunisair.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Champ Mot de passe -->
            <div class="form-group-custom">
                <label asp-for="Input.Password">
                    <i class="fas fa-lock me-1 text-primary"></i> Mot de passe
                </label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <!-- Se souvenir de moi -->
            <div class="mb-4 form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" style="width: 1.1em; height: 1.1em; margin-top: 0.15em;" />
                <label class="form-check-label text-muted ms-1" asp-for="Input.RememberMe">
                    Se souvenir de moi
                </label>
            </div>

            <!-- Bouton de connexion -->
            <button id="login-submit" type="submit" class="btn btn-tunisair shadow-sm mb-4">
                <i class="fas fa-sign-in-alt me-2"></i> Se connecter
            </button>
            
            <!-- Liens d'actions nettoyés -->
            <div class="text-center pt-2 d-flex flex-column gap-2">
                <br />
                <div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none text-muted fw-semibold small">
                        <i class="fas fa-question-circle me-1"></i> Mot de passe oublié ?
                    </a>
                </div>
                <br />
                <div>
                    <a asp-area="Identity" asp-page="/Account/Register" class="text-decoration-none text-primary fw-semibold small">
                        <i class="fas fa-user-plus me-1"></i> Créer un nouveau compte administrateur
                    </a>
                </div>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>