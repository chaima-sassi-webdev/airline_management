@model MonProjetAirlplane.Models.Flight

@{
    ViewData["Title"] = "Modifier le Vol";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow p-4">
        <h3 class="text-warning mb-3"><i class="fas fa-edit"></i> Modifier le Vol @Model.Vol</h3>
        <hr />
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="FN_CARRIER" class="form-label">Transporteur</label>
                    <input asp-for="FN_CARRIER" class="form-control" />
                    <span asp-validation-for="FN_CARRIER" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="FN_NUMBER" class="form-label">Numéro de Vol</label>
                    <input asp-for="FN_NUMBER" class="form-control" />
                    <span asp-validation-for="FN_NUMBER" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Immatriculation" class="form-label"></label>
                    <input asp-for="Immatriculation" class="form-control" />
                    <span asp-validation-for="Immatriculation" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ArrivalEscale" class="form-label"></label>
                <input asp-for="ArrivalEscale" class="form-control" />
                <span asp-validation-for="ArrivalEscale" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PaxClub" class="form-label"></label>
                    <input asp-for="PaxClub" class="form-control" type="number" />
                    <span asp-validation-for="PaxClub" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PaxEco" class="form-label"></label>
                    <input asp-for="PaxEco" class="form-control" type="number" />
                    <span asp-validation-for="PaxEco" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="TarifMoyen" class="form-label"></label>
                <input asp-for="TarifMoyen" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="TarifMoyen" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
                <button type="submit" class="btn btn-warning text-white"><i class="fas fa-sync-alt"></i> Mettre à jour</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}