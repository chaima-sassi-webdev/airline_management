@model MonProjetAirlplane.Models.Flight

@{
    ViewData["Title"] = "Ajouter un Vol";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow p-4">
        <h3 class="text-primary mb-3"><i class="fas fa-plus-circle"></i> Ajouter un Nouveau Vol</h3>
        <hr />
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="FN_CARRIER" class="form-label">Transporteur</label>
                    <input asp-for="FN_CARRIER" class="form-control" placeholder="Ex: TU" />
                    <span asp-validation-for="FN_CARRIER" class="text-danger"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="FN_NUMBER" class="form-label">Numéro de Vol</label>
                    <input asp-for="FN_NUMBER" class="form-control" placeholder="Ex: 722" />
                    <span asp-validation-for="FN_NUMBER" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="AC_REGISTRATION" class="form-label">Immatriculation</label>
                    <input asp-for="AC_REGISTRATION" class="form-control" placeholder="Ex: TS-IMV" />
                    <span asp-validation-for="AC_REGISTRATION" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DAY_OF_ORIGIN" class="form-label">Date</label>
                    <input asp-for="DAY_OF_ORIGIN" class="form-control" type="date" />
                    <span asp-validation-for="DAY_OF_ORIGIN" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ARR_AP_ACTUAL" class="form-label">Escale d'arrivée</label>
                <input asp-for="ARR_AP_ACTUAL" class="form-control" placeholder="Ex: CDG" />
                <span asp-validation-for="ARR_AP_ACTUAL" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PAX_FLOWN_C" class="form-label">Pax Club</label>
                    <input asp-for="PAX_FLOWN_C" class="form-control" type="number" />
                    <span asp-validation-for="PAX_FLOWN_C" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PAX_FLOWN_Y" class="form-label">Pax Eco</label>
                    <input asp-for="PAX_FLOWN_Y" class="form-control" type="number" />
                    <span asp-validation-for="PAX_FLOWN_Y" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="AVG_FARE" class="form-label">Tarif Moyen</label>
                <input asp-for="AVG_FARE" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="AVG_FARE" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Retour</a>
                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}