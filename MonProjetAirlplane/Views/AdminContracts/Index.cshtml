@model IEnumerable<MonProjetAirlplane.Models.ContractViewModel>

@{
    ViewData["Title"] = "Gestion des Contrats";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestion des Contrats (Contracts)</h2>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-sm">Retour au Dashboard</a>
            <a asp-action="Create" class="btn btn-primary btn-sm">Nouveau Contrat</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Titre</th>
                            <th>Fournisseur</th>
                            <th>Début</th>
                            <th>Fin</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.SupplierName</td>
                                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Amount.ToString("N2")</td>
                                <td>
                                    <span class="badge @(item.Status == "Actif" ? "bg-success" : "bg-danger")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modifier</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce contrat ?');">Supprimer</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>