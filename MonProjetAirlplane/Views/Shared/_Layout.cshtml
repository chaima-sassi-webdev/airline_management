<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tunisair App</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">Tunisair Dashboard</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-white fw-bold me-3" asp-controller="Flights" asp-action="Index">✈️ Gestion des Vols</a>
                    <a class="nav-link text-white fw-bold me-3" asp-controller="AdminUsers" asp-action="Index">👥 Utilisateurs</a>
                    <a class="nav-link text-white fw-bold" asp-controller="AdminSuppliers" asp-action="Index">🏢 Fournisseurs</a>
                    <a class="nav-link text-white fw-bold me-3" asp-controller="AdminContracts" asp-action="Index">📄 Contrats</a>
                    <a class="nav-link text-white fw-bold me-3" asp-controller="AdminDelays" asp-action="Index">⏱️ Retards</a>
                    <a class="nav-link text-white fw-bold me-3" asp-controller="AdminArticles" asp-action="Index">🍔 Articles & Menus</a>
                   
                    <a class="nav-link text-dark" asp-controller="AdminAlerts" asp-action="Index">
                        🔔 Alertes <span class="badge bg-danger">!</span>
                    </a>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container">
            &copy; 2026 - Tunisair App
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>